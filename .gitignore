# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Ignore gRPC generated files
**/generated/*_pb2.py
**/generated/*_pb2.pyi
**/generated/*_pb2_grpc.py
**/generated/**/*_pb2.py
**/generated/**/*_pb2.pyi
**/generated/**/*_pb2_grpc.py

# Docs and Local DB
doc/
ingestion_docs/
qdrant_data/
sqlite_db/
go_sqlite_db/

# Worktrees
.worktrees/

# Compiled binaries and local configurations
# (See https://github.com/github/gitignore/blob/main/Go.gitignore)

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries generated by 'go test -c'
*.test

# Output files and test/coverage profiles
*.out
coverage.txt
coverage.out
*.coverprofile
profile.cov

# Dependency directories
# (Only uncomment if you do not want to commit your vendor folder)
# vendor/

# Go workspace file
go.work
go.work.sum

# Environment files containing local secrets
.env
.env.*
