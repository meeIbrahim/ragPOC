# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# gRPC generated files are committed, not ignored: the Python stubs in
# services/rag-service/src/generated are needed by pytest and the rag image, whose build context
# cannot reach protos/. `make grpc-generate` rewrites them.

# Docs and Local DB
doc/
ingestion_docs/
qdrant_data/
sqlite_db/
go_sqlite_db/

# Worktrees
.worktrees/

# Compiled binaries and local configurations
# (See https://github.com/github/gitignore/blob/main/Go.gitignore)

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/

# Test binaries generated by 'go test -c'
*.test

# Output files and test/coverage profiles
*.out
coverage.txt
coverage.out
*.coverprofile
profile.cov

# Dependency directories
# (Only uncomment if you do not want to commit your vendor folder)
# vendor/

# Go workspace file
go.work
go.work.sum

# Environment files containing local secrets
.env
.env.*

# Local Claude Code workspace (handoff docs, notes)
.claude/
